# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL Local / Docker)
# Replace with your actual database credentials
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/meeting_room_booking_db
DATABASE_TEST_URL=postgresql://postgres:your_password@localhost:5433/meeting_room_booking_test_db

# Security & Tokens (Replace with strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS & Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Business Rules
OFFICE_TIMEZONE=Asia/Kolkata
BUSINESS_HOURS_START=07:00
BUSINESS_HOURS_END=22:00
BUSINESS_DAYS=1,2,3,4,5,6,7

# Optional SMTP Settings (leave empty to run with in-app notifications only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@company.com
