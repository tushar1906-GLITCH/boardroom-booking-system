{
  "name": "meeting-room-booking-system",
  "version": "1.0.0",
  "description": "Production-grade Meeting Room Booking System built with React, NestJS, and PostgreSQL",
  "scripts": {
    "start:backend": "npm run start:dev --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "db:start": "start-db.bat",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:backend:e2e": "npm run test:e2e --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "migration:run": "npm run migration:run --prefix backend",
    "migration:revert": "npm run migration:revert --prefix backend",
    "seed": "npm run seed --prefix backend",
    "db:reset": "npm run db:reset --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}